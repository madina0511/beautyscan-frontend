# Public frontend settings only. Never put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:3000/graphql

# Units of local currency per 1 USD. Set approved positive decimal rates.
# Blank values mean conversion unavailable. No default or live rates are supplied.
# Restart next dev after changing these. Production changes require a rebuild.
# Copy these keys to frontend/.env.local and supply approved rates there.
NEXT_PUBLIC_USD_TO_UZS=
NEXT_PUBLIC_USD_TO_KRW=
