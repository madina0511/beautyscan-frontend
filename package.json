{
  "name": "beautyscan-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit --incremental false",
    "lint": "eslint . --max-warnings 0",
    "test:auth": "node --test tests/auth.test.mjs",
    "test:products": "node --test tests/products.test.mjs",
    "test:pricing": "node --test tests/pricing.test.mjs",
    "test:profile": "node --test tests/profile.test.mjs",
    "test:images": "node --test tests/product-image.test.mjs tests/product-media.test.mjs tests/studio.test.mjs",
    "test:packaging": "node --test tests/packaging.test.mjs tests/description.test.mjs tests/description-copy.test.mjs"
  },
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.19.1 <12"
  },
  "packageManager": "npm@11.19.1",
  "dependencies": {
    "next": "16.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  }
}
